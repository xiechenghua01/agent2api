# Agent2API 部署配置（docker compose 自动读取本文件）。
# 全部留空即可正常部署：启动后打开面板，首次会提示注册管理员账号。

# 面板管理员：留空 = 启动后在面板注册（推荐）；填了 = 跳过注册，用这里的账号登录。
AGENT2API_ADMIN_USER=
# 密码直接填明文（启动时自动转成 bcrypt 哈希，库里只存哈希）。
AGENT2API_ADMIN_PASSWORD=

# 面板分端口：留空 = 面板与网关同端口；填了（如 3066）= 面板单独监听该端口，
# 主端口只保留 /v1 网关 —— 公网只映射主端口，即可把面板留在内网。
AGENT2API_PANEL_PORT=

# 登录 / 注册的人机校验（ALTCHA）：留空 = 默认开启；填 0 = 关闭。
# 想在部署时就关掉、不用先登录进设置页点开关，在这里填 0 即可。
# 优先级：设置页写入的值 > 这里 > 默认开启 —— 一旦在设置页动过开关，
# 以设置页为准（本行不再生效）。
AGENT2API_CAPTCHA_ENABLED=
